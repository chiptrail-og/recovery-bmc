# recovery-bmc environment defaults
# Priority: CLI args > OS env > .env

# Transport: usb | i3c
RECOVERY_BMC_TRANSPORT=usb

# USB settings
RECOVERY_BMC_USB_VENDOR_ID=0x0424
RECOVERY_BMC_USB_PRODUCT_ID=0x0007
# (Windows cmd) set RECOVERY_BMC_USB_VENDOR_ID=0x0424
# (Linux/macOS) export RECOVERY_BMC_USB_VENDOR_ID=0x0424
RECOVERY_BMC_DISCOVERY_TIMEOUT=10.0
RECOVERY_BMC_TRANSFER_TIMEOUT=10.0

# I3C settings
# RECOVERY_BMC_I3C_UART=COM5
# Legacy alias also supported: I3C_BLASTER_UART
RECOVERY_BMC_I3C_CLK_KHZ=12500
# RECOVERY_BMC_I3C_ADDR=0x08
RECOVERY_BMC_I3C_ENTDAA_ADDR=0x08
# Optional i3cblaster source path override (default fallback: ./I3CBlaster/python)
# RECOVERY_BMC_I3CBLASTER_PYTHON=./I3CBlaster/python

# Agent behavior
RECOVERY_BMC_POLL_INTERVAL=0.01
RECOVERY_BMC_STATE_TIMEOUT=30.0
RECOVERY_BMC_CHUNK_SIZE=64
RECOVERY_BMC_LOG_LEVEL=INFO

# Optional image paths
# RECOVERY_BMC_FIRMWARE=./firmware.bin
# RECOVERY_BMC_CALIPTRA_FMC_RT=./caliptra.bin
# RECOVERY_BMC_SOC_MANIFEST=./manifest.bin
# RECOVERY_BMC_MCU_RUNTIME=./mcu.bin
# RECOVERY_BMC_APP_CORE_IMAGES=./app0.bin,./app1.bin

# Optional explicit dotenv path override
# RECOVERY_BMC_DOTENV=/absolute/path/to/.env

# Optional netboot helper defaults (scripts/netboot/*)
# RECOVERY_BMC_NETBOOT_INTERFACE=enx001122334455
# RECOVERY_BMC_NETBOOT_DHCP_RANGE=192.168.88.50,192.168.88.150,12h
# RECOVERY_BMC_TFTP_ROOT=./scripts/netboot/tftp-root
# RECOVERY_BMC_NETBOOT_BIND_ADDRESS=192.168.88.1
